   "tool": "service_status",
   "visible": true,
   "payload": {
    "service": "$svc_0",
    "state": "running"
   }
  },
  {
   "key": "log_state",
   "tool": "read_logs",
   "visible": false,
   "payload": {
    "service": "$svc_0",
