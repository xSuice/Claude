{
 "spec_version": "1.1",
 "family_id": "DUMMY_PUBLIC_DEV_S8_F03",
 "partition": "dev",
 "stratum": "S8",
 "design_note": "worker crash; conclusive_state=False budget=1 decoys=0",
 "vars": {
