  "Der Auftrag für {svc_0} wurde unterbrochen. Mach dort weiter.",
  "Worker abgestürzt, bitte {tid} fortsetzen.",
  "Setze die unterbrochene Aufgabe {tid} auf {svc_0} fort."
 ],
 "read_budget": 1,
 "catalog": [
  {
   "tool": "service_status",
   "params": {
    "service": [
     "$svc_0",
     "$svc_1"
    ]
   }
  },
  {
   "tool": "read_config",
   "params": {
    "service": [
     "$svc_0",
     "$svc_1"
    ]
   }
  },
  {
   "tool": "read_logs",
   "params": {
    "service": [
     "$svc_0",
     "$svc_1"
    ],
    "window": [
     "last_5m",
     "last_1h"
    ]
   }
  }
 ],
 "observations": [
  {
   "key": "ledger",
   "tool": "tool_result",
   "visible": true,
   "payload": {
    "service": "$svc_0",
    "task": "$tid",
