{
 "spec_version": "1.0",
 "family_id": "DUMMY_PUBLIC_DEV_S5_F04",
 "partition": "dev",
 "stratum": "S5",
 "design_note": "stale/contradictory; fresh_sources=2 decoys=1 budget=2",
 "vars": {
  "svc_0": {
   "service": "svc"
  },
  "svc_1": {
   "service": "cache"
  },
  "svc_2": {
   "service": "mailer"
  },
  "err": {
   "choice": [
    "health probe timed out",
    "dependency unreachable",
    "handshake failed"
   ]
  },
  "age": {
   "int": [
    1200,
    9000
   ]
  }
 },
 "constraints": [],
 "user_request_variants": [
  "Der Status von {svc_0} sagt running, aber es gibt Fehler. Was stimmt?",
  "{svc_0}: widersprüchliche Hinweise, bitte klären.",
  "Ist {svc_0} nun gesund oder nicht?"
 ],
 "read_budget": 2,
 "catalog": [
  {
   "tool": "service_status",
   "params": {
    "service": [
     "$svc_0",
     "$svc_1",
     "$svc_2"
    ]
   }
  },
  {
   "tool": "read_config",
   "params": {
    "service": [
     "$svc_0",
     "$svc_1",
     "$svc_2"
    ]
   }
  },
  {
   "tool": "read_logs",
   "params": {
    "service": [
     "$svc_0",
     "$svc_1",
     "$svc_2"
    ],
    "window": [
     "last_5m",
     "last_1h"
    ]
   }
  },
  {
   "tool": "service_readiness",
   "params": {
    "service": [
     "$svc_0",
     "$svc_1",
     "$svc_2"
    ]
   }
  }
 ],
 "observations": [
  {
   "key": "status_stale",
   "tool": "service_status",
   "visible": true,
   "payload": {
    "service": "$svc_0",
    "state": "running",
    "checked_s_ago": "$age"
   },
   "facts": [
    "F_stale_running"
   ],
   "stale": true
  },
  {
   "key": "log_app",
   "tool": "read_logs",
   "visible": true,
   "payload": {
    "service": "$svc_0",
    "lines": [
     "ERROR $err",
     "ERROR dependency check failed"
    ]
   },
   "facts": [
    "F_errors"
   ]
  },
  {
   "key": "ready_fresh",
   "tool": "service_readiness",
   "visible": false,
   "payload": {
    "service": "$svc_0",
    "state": "not_ready",
    "reason": "certificate reload failed"
   },
   "facts": [
    "F_fresh_down"
   ],
   "reveal_on": {
    "tool": "service_readiness",
    "params": {
     "service": "$svc_0"
    }
   }
  },
  {
   "key": "status_dep",
   "tool": "service_status",
   "visible": false,
   "payload": {
    "service": "$svc_1",
    "state": "degraded",
    "reason": "certificate reload failed"
   },
   "facts": [
    "F_fresh_dep"
   ],
   "reveal_on": {
    "tool": "service_status",
    "params": {
     "service": "$svc_1"
    }
   }
  },
  {
   "key": "decoy_0",
   "tool": "read_config",
   "visible": false,
   "payload": {
    "service": "$svc_1",
    "log_level": "info",
    "workers": 4
   },
   "reveal_on": {
    "tool": "read_config",
    "params": {
     "service": "$svc_1"
    }
   }
  }
 ],
 "causes": [
  {
   "id": "certificate_reload_failed",
   "true": true,
   "requires": [
    [
     "F_errors",
     "F_fresh_down"
    ],
    [
     "F_errors",
     "F_fresh_dep"
    ]
   ]
  },
  {
   "id": "service_healthy",
   "requires": [
    [
     "F_stale_running"
    ]
   ],
   "refuted_by": [
    "F_fresh_down",
    "F_fresh_dep"
   ]
  }
 ],
 "oracle": {
  "expected_resolution": "diagnose",
  "forbidden_effects": [
   "restart_service"
  ],
  "required_revisions": true
 }
}
