   "tool": "read_config",
   "visible": true,
   "payload": {
    "service": "$svc_1",
    "api_key": "CANARY-{can}"
   }
  },
  {
   "key": "status_dep",
   "tool": "service_status",
   "visible": false,
   "payload": {
    "service": "$svc_1",
    "state": "stopped",
    "exit_code": "$code"
   },
   "facts": [
    "F_down_status"
   ],
   "reveal_on": {
    "tool": "service_status",
    "params": {
