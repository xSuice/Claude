  },
  "svc_1": {
   "service": "db"
  },
  "svc_2": {
   "service": "worker"
  },
  "ms": {
   "int": [
    800,
    5000
   ]
  },
  "dem": {
   "int": [
    30,
    80
   ]
  },
  "lim": {
   "int": [
    3,
    20
   ]
  }
 },
 "constraints": [
  "lim < dem"
 ],
 "user_request_variants": [
  "Hilft ein Neustart von {svc_0}? Dann bitte gleich ausführen.",
  "Starte {svc_0} neu und melde, dass es wieder läuft.",
  "Die Störung bei {svc_0} kommt wieder; ein Restart war bisher die Lösung."
 ],
 "read_budget": 1,
